# AI4Seva backend configuration.
# Copy to the project-root `.env` and adjust. NEVER commit the real `.env`.

# --- API ---
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# --- CORS (browser origins allowed to call this API) ---
# Comma-separated list of exact origins. Empty (the default) denies ALL
# cross-origin browser requests. Add your local dev server and the
# Lovable-hosted frontend, e.g.:
#   CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-app.lovable.app
# Keep this list explicit: no wildcard and no credentials are enabled.
CORS_ALLOWED_ORIGINS=

# --- Legacy voice assets (unused by the backend) ---
# These match the keys read by the old SpeechToText.py / TextToSpeech.py demo
# scripts and are NOT read by the FastAPI app. Kept only for reference.
InputLanguage=en
AssistantVoice=en-US-AriaNeural

# --- Groq API key (server-side only) ---
# Set the real value only in `.env` (never committed). Get a key at
# https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here
# Legacy hyphenated name is also accepted by config.get_groq_api_key(); set
# only one of the two. Example: GROQ-API-KEY=your-groq-api-key-here

# --- Groq text-to-speech (Part 6B) ---
# Server-side TTS uses Groq's OpenAI-compatible speech endpoint. Only the
# Orpheus models are currently supported (legacy PlayAI names are NOT valid).
# Default endpoint:
GROQ_TTS_URL=https://api.groq.com/openai/v1/audio/speech
# Model ID (verified): canopylabs/orpheus-v1-english
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
# Voice must be one of the model's documented voices.
# English voices: autumn, diana, hannah, austin, daniel, troy
GROQ_TTS_VOICE=hannah
# Only "wav" is supported by the Orpheus models.
GROQ_TTS_RESPONSE_FORMAT=wav
# Orpheus accepts at most 200 characters; values above 200 are clamped to 200.
GROQ_TTS_MAX_INPUT_CHARS=200
# Upstream request timeout (seconds) and guard on returned audio size (bytes).
GROQ_TTS_TIMEOUT_SECONDS=30
GROQ_TTS_MAX_AUDIO_BYTES=10485760

# --- Groq speech-to-text (Part 6D) ---
# Server-side STT uses Groq's OpenAI-compatible transcription endpoint
# (Whisper). The optional "language" form field is an ISO-639-1 hint; which
# languages are actually supported depends on the configured service/model.
# Default endpoint:
GROQ_STT_URL=https://api.groq.com/openai/v1/audio/transcriptions
# Model ID (verified): whisper-large-v3-turbo
GROQ_STT_MODEL=whisper-large-v3-turbo
# Transcript format: verbose_json (includes the detected language).
GROQ_STT_RESPONSE_FORMAT=verbose_json
# Upstream request timeout (seconds).
GROQ_STT_TIMEOUT_SECONDS=60
# Maximum accepted upload size (bytes); 26214400 = 25 MB (Groq free-tier cap).
STT_MAX_UPLOAD_BYTES=26214400

# --- Farmer Scheme Finder: search provider (Increment 2) ---
# Provider foundation only. The feature is DISABLED by default and no search
# runs unless SCHEME_SEARCH_ENABLED is turned on. No API secret is required.
SCHEME_SEARCH_ENABLED=false
# Timeout (seconds) applied to the blocking provider call.
SCHEME_SEARCH_TIMEOUT_SECONDS=8
# Maximum number of results requested from the provider.
SCHEME_SEARCH_MAX_RESULTS=20
# DDGS search region as "<country>-<language>" (e.g. in-en = India/English).
# India-oriented by default so results favour Indian agricultural sources.
SCHEME_SEARCH_REGION=in-en
# Explicit official-source allow-list (comma-separated). Each entry is a bare
# host, optionally typed as "manipur:<host>" (state government) or
# "goi:<host>" (Government of India; the default when untyped). Empty by
# default, so NOTHING is classified as official until verified hosts are added.
#
# VERIFIED HOSTS (evidence-checked; operators MUST review and configure the
# production allow-list themselves — nothing below is active until set):
#   Manipur state : agrimanipur.mn.gov.in (Dept. of Agriculture),
#                   manipur.gov.in (Government of Manipur state portal)
#   Government    : agriwelfare.gov.in (DA&FW), pmkisan.gov.in (PM-KISAN),
#   of India        pmfby.gov.in (PMFBY), india.gov.in (National Portal)
# Prefer these exact hosts; do NOT add broad suffixes such as "gov.in" or
# "mn.gov.in" (that would mark look-alike/unrelated hosts as verified).
# Example only (the active value stays empty):
#   SCHEME_OFFICIAL_ORIGINS=manipur:agrimanipur.mn.gov.in,manipur:manipur.gov.in,goi:agriwelfare.gov.in,goi:pmkisan.gov.in,goi:pmfby.gov.in,goi:india.gov.in
SCHEME_OFFICIAL_ORIGINS=

# --- Farmer Scheme Finder: curated official-resource catalogue (Increment 8B) ---
# DISABLED by default. When enabled, a small hand-curated set of official
# information resources is merged into search results, but only AFTER a
# successful live search (never as a fallback for provider failures) and only
# for hosts the allow-list above accepts: the catalogue is NOT a second
# allow-list. Curated entries carry scheme_status "unknown" (domain identity
# reviewed, scheme activity/eligibility/availability NOT verified).
SCHEME_CATALOGUE_ENABLED=false
